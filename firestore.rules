rules_version = '2';

// ============================================================================
// Nicolaus English Platform — Firestore Security Rules (versão Spark/gratuita)
//
// Sem custom claims (não usamos Cloud Functions/Admin SDK nesta versão).
// O papel "professor" é determinado consultando config/meta.professorUid —
// só existe UM professor, e o documento config/meta só pode ser criado uma
// única vez (a regra de "create" abaixo bloqueia qualquer criação seguinte).
// Um aluno nunca consegue "virar professor": não há campo de papel para
// editar em seu próprio documento, o papel vem inteiramente de quem é dono
// do uid gravado em config/meta.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isProfessor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/meta)
        && get(/databases/$(database)/documents/config/meta).data.professorUid == request.auth.uid;
    }
    function isSelf(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }

    // ------------------------------------------------------------------
    // config/meta — guarda o uid do professor. Leitura pública (a tela
    // inicial precisa saber, ANTES de qualquer login, se já existe um
    // professor configurado ou se deve mostrar a tela de criação de
    // conta). Só pode ser CRIADO uma vez — a condição "!exists(...)"
    // garante que ninguém consiga criar um segundo professor depois.
    // Nunca pode ser alterado ou apagado por ninguém pelo app.
    // ------------------------------------------------------------------
    match /config/meta {
      allow read: if true;
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/config/meta)
        && request.resource.data.professorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // directory/{studentId} — espelho público mínimo (name, level, email)
    // usado só para a tela "quem é você?" no login do aluno. O professor
    // mantém isso em sincronia manualmente (no mesmo lote de escrita que
    // atualiza students/{uid}) — não há mais uma Cloud Function fazendo
    // isso automaticamente.
    // ------------------------------------------------------------------
    match /directory/{studentId} {
      allow read: if true;
      allow write: if isProfessor();
    }

    // ------------------------------------------------------------------
    // students/{studentId} — perfil do aluno. O professor cria e apaga
    // (a conta no Firebase Auth é criada do lado do cliente, com uma
    // instância secundária do app, então o Firestore só precisa
    // confirmar que quem está escrevendo é o professor). O próprio
    // aluno pode atualizar seu documento (resultado de teste de
    // nivelamento, flag de troca de senha) — o pior cenário de abuso é
    // inflar o próprio nível, sempre visível e corrigível pelo professor.
    // ------------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isProfessor() || isSelf(studentId);
      allow create: if isProfessor();
      allow update: if isProfessor() || isSelf(studentId);
      allow delete: if isProfessor();
    }

    // ------------------------------------------------------------------
    // classes/{classId} — agenda de aulas. Só o professor escreve. Aluno
    // só lê as próprias aulas.
    // ------------------------------------------------------------------
    match /classes/{classId} {
      allow read: if isProfessor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isProfessor();
    }

    // ------------------------------------------------------------------
    // payments/{paymentId} — financeiro. Só o professor escreve. Aluno
    // só lê os próprios pagamentos.
    // ------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isProfessor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isProfessor();
    }

    // ------------------------------------------------------------------
    // assignments/{assignmentId} — exercícios atribuídos + prática livre.
    // Professor tem controle total (inclusive corrigir redações
    // manualmente, mudando status de "aguardando_correcao" para
    // "concluida"). Aluno só enxerga as próprias atividades; pode criar
    // registros de prática livre para si mesmo, e só pode completar
    // (nunca reabrir ou alterar o resultado de) uma atividade pendente
    // que seja sua.
    // ------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isProfessor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isProfessor()
        || (isSignedIn()
            && request.resource.data.studentId == request.auth.uid
            && request.resource.data.assignedBy == 'aluno'
            && (request.resource.data.status == 'concluida' || request.resource.data.status == 'aguardando_correcao'));
      allow update: if isProfessor()
        || (isSignedIn()
            && resource.data.studentId == request.auth.uid
            && resource.data.status == 'pendente'
            && (request.resource.data.status == 'concluida' || request.resource.data.status == 'aguardando_correcao'));
      allow delete: if isProfessor();
    }
  }
}
