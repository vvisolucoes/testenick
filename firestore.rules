rules_version = '2';

// ============================================================================
// Nicolaus English Platform — Firestore Security Rules
//
// Papéis (roles) são definidos via CUSTOM CLAIMS no token de autenticação
// (request.auth.token.role), nunca em um documento do Firestore — assim um
// aluno não tem como "virar professor" editando seus próprios dados, porque
// claims só podem ser escritas pelo Admin SDK (ou seja, pelas Cloud Functions
// em functions/index.js, nunca pelo cliente).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isProfessor() {
      return isSignedIn() && request.auth.token.role == 'professor';
    }
    function isStudent() {
      return isSignedIn() && request.auth.token.role == 'student';
    }
    function isSelf(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }

    // ------------------------------------------------------------------
    // config/meta — flag de setup inicial (existe/não existe professor).
    // Leitura pública é necessária pois a tela de login precisa decidir,
    // ANTES de qualquer autenticação, se mostra "criar conta do professor"
    // ou a tela normal de login. Não guarda nada sensível (só um uid).
    // Escrita só acontece via Cloud Function (bootstrapProfessor).
    // ------------------------------------------------------------------
    match /config/meta {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // directory/{studentId} — espelho público mínimo (somente "name")
    // usado exclusivamente para popular a lista "quem é você?" na tela
    // de login do aluno, sem expor nível, notas, pagamentos etc.
    // Mantido em sincronia automaticamente pela Cloud Function
    // syncStudentDirectory sempre que students/{uid} muda.
    // ------------------------------------------------------------------
    match /directory/{studentId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // students/{studentId} — perfil completo do aluno (nível, histórico
    // de testes, contato, status). Criação e exclusão só via Cloud
    // Function (Admin SDK), pois envolvem também a conta no Firebase Auth.
    // O próprio aluno pode alterar o próprio documento (ex: resultado do
    // teste de nivelamento, flag de troca de senha obrigatória) — o pior
    // cenário de abuso é o aluno inflar o próprio nível, o que o professor
    // sempre pode ver e corrigir; não é uma falha de privacidade entre
    // alunos, já que cada um só enxerga e só escreve o próprio documento.
    // ------------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isProfessor() || isSelf(studentId);
      allow update: if isProfessor() || isSelf(studentId);
      allow create, delete: if false;
    }

    // ------------------------------------------------------------------
    // classes/{classId} — agenda de aulas. Só o professor cria/edita/
    // remove. O aluno só lê as próprias aulas.
    // ------------------------------------------------------------------
    match /classes/{classId} {
      allow read: if isProfessor() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isProfessor();
    }

    // ------------------------------------------------------------------
    // payments/{paymentId} — financeiro. Só o professor escreve. O aluno
    // pode ler os próprios pagamentos (transparência), nunca os de outros.
    // ------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isProfessor() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isProfessor();
    }

    // ------------------------------------------------------------------
    // assignments/{assignmentId} — exercícios atribuídos + prática livre.
    // Professor tem controle total. Aluno só enxerga as próprias
    // atividades; pode criar registros de prática livre para si mesmo
    // (assignedBy == 'aluno') e só pode concluir (nunca reabrir ou alterar
    // resultado de) uma atividade pendente que seja sua.
    // ------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isProfessor() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isProfessor()
        || (isStudent()
            && request.resource.data.studentId == request.auth.uid
            && request.resource.data.assignedBy == 'aluno'
            && request.resource.data.status == 'concluida');
      allow update: if isProfessor()
        || (isStudent()
            && resource.data.studentId == request.auth.uid
            && resource.data.status == 'pendente'
            && request.resource.data.status == 'concluida');
      allow delete: if isProfessor();
    }
  }
}
